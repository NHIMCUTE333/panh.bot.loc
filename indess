@import "tailwindcss";

@layer base {
  body {
    background-color: #FFFDF0;
    color: #4A4A4A;
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  }

  h1, h2, h3, .font-serif {
    font-family: 'Cormorant Garamond', Georgia, serif;
  }
}

.geometric-border {
  border: 1px solid rgba(212, 163, 115, 0.3);
}

.geometric-card {
  border: 1px solid rgba(212, 163, 115, 0.25);
  background-color: #FFFFFF;
}

@keyframes pulse-soft {
  0% { transform: scale(1); box-shadow: 0 4px 12px rgba(212, 163, 115, 0.3); }
  50% { transform: scale(1.04); box-shadow: 0 6px 20px rgba(212, 163, 115, 0.5); }
  100% { transform: scale(1); box-shadow: 0 4px 12px rgba(212, 163, 115, 0.3); }
}

.animate-pulse-soft {
  animation: pulse-soft 2s infinite ease-in-out;
}

@keyframes float-glow {
  0% {
    transform: translateY(0px);
    box-shadow: 0 0 20px rgba(212, 163, 115, 0.45), 0 0 40px rgba(255, 249, 214, 0.35), 0 10px 25px rgba(0, 0, 0, 0.2);
  }
  50% {
    transform: translateY(-8px);
    box-shadow: 0 0 35px rgba(212, 163, 115, 0.8), 0 0 65px rgba(255, 249, 214, 0.6), 0 18px 35px rgba(0, 0, 0, 0.25);
  }
  100% {
    transform: translateY(0px);
    box-shadow: 0 0 20px rgba(212, 163, 115, 0.45), 0 0 40px rgba(255, 249, 214, 0.35), 0 10px 25px rgba(0, 0, 0, 0.2);
  }
}

.animate-float-glow {
  animation: float-glow 4s ease-in-out infinite;
}

@keyframes float-wooden-sign {
  0% { transform: translateY(0px) rotate(2deg); }
  50% { transform: translateY(-16px) rotate(-2deg); }
  100% { transform: translateY(0px) rotate(2deg); }
}

.animate-wooden-sign {
  transform-origin: top center;
  animation: float-wooden-sign 4.5s ease-in-out infinite;
}

@keyframes char-card-float {
  0% {
    transform: translateY(0px);
    box-shadow: 0 0 20px rgba(212, 163, 115, 0.45), 0 0 40px rgba(255, 220, 150, 0.35), 0 10px 25px rgba(0, 0, 0, 0.3);
  }
  50% {
    transform: translateY(-12px);
    box-shadow: 0 0 35px rgba(212, 163, 115, 0.85), 0 0 65px rgba(255, 230, 160, 0.65), 0 20px 38px rgba(0, 0, 0, 0.4);
  }
  100% {
    transform: translateY(0px);
    box-shadow: 0 0 20px rgba(212, 163, 115, 0.45), 0 0 40px rgba(255, 220, 150, 0.35), 0 10px 25px rgba(0, 0, 0, 0.3);
  }
}

.animate-char-card-glow {
  animation: char-card-float 3.8s ease-in-out infinite;
}

/* Custom scrollbar */
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: #FFFDF0;
}
::-webkit-scrollbar-thumb {
  background: #D4A373;
  border-radius: 9999px;
}
::-webkit-scrollbar-thumb:hover {
  background: #B08256;
}
